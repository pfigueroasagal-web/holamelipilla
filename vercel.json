{
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/farmacias",   "destination": "/farmacias.html" },
    { "source": "/salud",       "destination": "/salud.html" },
    { "source": "/seguridad",   "destination": "/seguridad.html" },
    { "source": "/ferias",      "destination": "/ferias.html" },
    { "source": "/colegios",    "destination": "/colegios.html" },
    { "source": "/apoyar",      "destination": "/apoyar.html" },
    { "source": "/sugerencias", "destination": "/sugerencias.html" },
    { "source": "/juegos",      "destination": "/juegos.html" },
    { "source": "/noticias",    "destination": "/noticias.html" },
    { "source": "/trabajos",    "destination": "/trabajos.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/api/turno",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
